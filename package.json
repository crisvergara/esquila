{
  "name": "esquila",
  "version": "0.1.6",
  "description": "Offline-first sheep counting and vaccination tools",
  "author": "Sheep++",
  "private": true,
  "type": "module",
  "main": "mac/main.js",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.888.0",
    "@aws-sdk/client-sesv2": "^3.888.0",
    "better-sqlite3": "^13.0.3",
    "body-parser": "^2.2.0",
    "bonjour-service": "^1.4.4",
    "express": "^5.1.0",
    "idb": "^8.0.3",
    "nodemailer": "^9.0.5",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "scripts": {
    "start": "node countserver.js",
    "build": "vite build",
    "build:cloud": "vite build --config vite.cloud.config.js",
    "check:syntax": "node --check countserver.js && node --check cloud/server.js && node --check mac/main.js",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:e2e",
    "check": "npm run check:syntax && npm run build && npm run build:cloud && npm run test",
    "build:mac": "npm run build && electron-builder --mac --publish never",
    "build:mac:arm64": "npm run build && electron-builder --mac --arm64 --publish never",
    "build:mac:x64": "npm run build && electron-builder --mac --x64 --publish never",
    "dev:mac": "npm run build && electron .",
    "dev:cloud": "vite --config vite.cloud.config.js",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^43.4.1",
    "electron-builder": "^26.0.12",
    "vite": "^7.1.5",
    "vite-plugin-pwa": "^1.0.2"
  },
  "build": {
    "appId": "com.sheepplusplus.esquila",
    "productName": "Esquila",
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "directories": {
      "output": "dist-mac"
    },
    "files": [
      "countserver.js",
      "tagger/modeschema.json",
      "build/**/*",
      "mac/**/*",
      "setup/**/*",
      "shared/**/*",
      "public/logo192.png",
      "shearers.json",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "public/logo512.png",
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "Esquila comparte el tagger y el monitor con los dispositivos conectados al WiFi del galpón.",
        "NSBonjourServices": [
          "_http._tcp"
        ]
      },
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "Esquila-${version}-${arch}.${ext}",
      "identity": "-"
    },
    "dmg": {
      "title": "Instalar Esquila"
    }
  }
}
